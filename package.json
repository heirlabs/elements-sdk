{
  "name": "@heir/element-sdk",
  "version": "0.1.0",
  "description": "SDK for building HEIR Desk Elements: bridge client, manifest validator, CSP generation, integrity/signing helpers, and a dev emulator.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heirlabs/elements-sdk.git"
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./integrity": {
      "types": "./dist/integrity.d.ts",
      "default": "./dist/integrity.js"
    },
    "./csp": {
      "types": "./dist/csp.d.ts",
      "default": "./dist/csp.js"
    },
    "./emulator": {
      "types": "./dist/emulator.d.ts",
      "default": "./dist/emulator.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run gen:schema",
    "gen:schema": "node scripts/gen-schema.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.1.0",
    "zod-to-json-schema": "^3.23.5"
  }
}
